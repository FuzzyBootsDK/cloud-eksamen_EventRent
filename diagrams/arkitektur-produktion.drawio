        <mxCell id="title" value="EventRent A/S – FORESLÅET PRODUKTIONSARKITEKTUR (designforslag)" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#1a237e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Kun CloudFront, S3, container-teknik og IaC er bygget i prototypen. Resten er forslag. Pile viser protokol og port." style="text;html=1;fontSize=16;fontColor=#455a64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1600" height="30" as="geometry"/></mxCell>


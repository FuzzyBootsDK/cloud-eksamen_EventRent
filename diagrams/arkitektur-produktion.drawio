        <mxCell id="legend" value="&lt;b&gt;Dækker eksamenskriterier&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Netværk:&lt;/b&gt; VPC/CIDR, subnets, DNS 53, HTTPS 443, 8080, 5432, VPN&lt;br&gt;&lt;br&gt;&lt;b&gt;Virtualisering/containere:&lt;/b&gt; ECS Fargate, ECR-images&lt;br&gt;&lt;br&gt;&lt;b&gt;Cloudmodel:&lt;/b&gt; PaaS (S3, Fargate, RDS), IaaS (VPC), SaaS (Identity Center)&lt;br&gt;&lt;br&gt;&lt;b&gt;Sikkerhed:&lt;/b&gt; WAF, TLS, Security Groups (least privilege), KMS, MFA, private subnets&lt;br&gt;&lt;br&gt;&lt;b&gt;Drift:&lt;/b&gt; multi-AZ, autoskalering, AWS Backup, CloudWatch&lt;br&gt;&lt;br&gt;&lt;b&gt;Økonomi:&lt;/b&gt; pay-as-you-go; NAT og RDS er de største poster&lt;br&gt;&lt;br&gt;&lt;b&gt;GDPR:&lt;/b&gt; data i EU-region, kryptering, adgangslog" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2200" y="260" width="270" height="900" as="geometry"/></mxCell>


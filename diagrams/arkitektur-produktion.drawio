        <mxCell id="r53" value="&lt;b&gt;Amazon Route 53&lt;/b&gt;&lt;br&gt;DNS (A/ALIAS-records)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#ff8f00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="cf" value="&lt;b&gt;Amazon CloudFront + AWS WAF&lt;/b&gt;&lt;br&gt;ACM-certifikat (TLS)&lt;br&gt;CDN + Shield Standard (DDoS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#ff8f00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="280" height="140" as="geometry"/></mxCell>

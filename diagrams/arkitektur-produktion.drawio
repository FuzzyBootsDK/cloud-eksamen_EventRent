<mxCell id="title" value="EventRent A/S – FORESLÅET PRODUKTIONSARKITEKTUR (designforslag)" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#1a237e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1700" height="50" as="geometry"/></mxCell>

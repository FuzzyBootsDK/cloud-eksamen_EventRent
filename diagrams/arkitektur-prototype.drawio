<mxfile host="app.diagrams.net">
  <diagram id="proto" name="Prototype (implementeret)">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="EventRent A/S – IMPLEMENTERET PROTOTYPE (dummy-side)" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#1a237e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Alt på tegningen er bygget og kan demonstreres. Pile viser protokol og port." style="text;html=1;fontSize=16;fontColor=#455a64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1300" height="30" as="geometry"/></mxCell>

        <mxCell id="dns" value="&lt;b&gt;Offentlig DNS&lt;/b&gt;&lt;br&gt;(resolver)&lt;br&gt;CNAME til *.cloudfront.net" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#37474f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;Bruger&lt;/b&gt;&lt;br&gt;Browser&lt;br&gt;(offentligt internet)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e8eaf6;strokeColor=#1a237e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="220" height="110" as="geometry"/></mxCell>

        <mxCell id="aws" value="AWS Cloud – region eu-north-1 (Stockholm) · administreret af AWS (PaaS/SaaS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fillColor=#fff8e1;strokeColor=#ff8f00;strokeWidth=3;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="1020" height="540" as="geometry"/></mxCell>
        <mxCell id="cf" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;CDN (edge)&lt;br&gt;TLS-certifikat (HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#ff8f00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Amazon S3&lt;/b&gt; (privat bucket)&lt;br&gt;index.html&lt;br&gt;Block Public Access · SSE-S3 · versionering" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="cfn" value="&lt;b&gt;AWS CloudFormation&lt;/b&gt;&lt;br&gt;infra/s3-cloudfront.yaml (IaC)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#6a1b9a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="amp" value="&lt;b&gt;AWS Amplify Hosting&lt;/b&gt;&lt;br&gt;alternativ (PaaS)&lt;br&gt;auto-deploy fra GitHub" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#ff8f00;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1220" y="330" width="190" height="120" as="geometry"/></mxCell>

        <mxCell id="dev" value="Lokal PC – Windows 11 · virtualisering: Docker Desktop (WSL2)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=3;fontColor=#0d47a1;" vertex="1" parent="1"><mxGeometry x="420" y="730" width="700" height="230" as="geometry"/></mxCell>
        <mxCell id="docker" value="&lt;b&gt;Docker-container&lt;/b&gt;&lt;br&gt;nginx:alpine + index.html&lt;br&gt;lytter på port 80" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="800" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="deploy" value="&lt;b&gt;deploy.ps1 / AWS CLI&lt;/b&gt;&lt;br&gt;cloudformation deploy&lt;br&gt;s3 cp index.html" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="810" y="800" width="260" height="120" as="geometry"/></mxCell>

        <mxCell id="gh" value="&lt;b&gt;GitHub-repo&lt;/b&gt;&lt;br&gt;cloud-eksamen_EventRent&lt;br&gt;kode + IaC + Dockerfile" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#eceff1;strokeColor=#37474f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1220" y="800" width="220" height="120" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;Dækker eksamenskriterier&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Netværk:&lt;/b&gt; DNS (53), HTTPS (443), HTTP (80 → 301), lokalt 8080&lt;br&gt;&lt;br&gt;&lt;b&gt;Virtualisering/containere:&lt;/b&gt; WSL2-VM + Docker-container&lt;br&gt;&lt;br&gt;&lt;b&gt;Cloudmodel:&lt;/b&gt; PaaS (S3, CloudFront, Amplify), IaC via CloudFormation&lt;br&gt;&lt;br&gt;&lt;b&gt;Sikkerhed:&lt;/b&gt; privat bucket, OAC, TLS, kryptering i hvile&lt;br&gt;&lt;br&gt;&lt;b&gt;Drift:&lt;/b&gt; versionering (simpel genetablering), teardown-script&lt;br&gt;&lt;br&gt;&lt;b&gt;Økonomi:&lt;/b&gt; free tier, pay-as-you-go&lt;br&gt;&lt;br&gt;&lt;i&gt;Ikke bygget: database, API, WAF, backup, VPN/SSO&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="270" height="850" as="geometry"/></mxCell>

        <mxCell id="e1" value="DNS-opslag&lt;br&gt;UDP/TCP 53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="dns"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="HTTPS · TCP 443 (TLS 1.2+)&lt;br&gt;HTTP TCP 80 → 301 til HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="HTTPS · TCP 443&lt;br&gt;OAC (SigV4-signerede kald)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cf" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="opretter/konfigurerer&lt;br&gt;(AWS API · HTTPS 443)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=14;dashed=1;strokeColor=#6a1b9a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cfn" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="HTTP · TCP 8080&lt;br&gt;(localhost:8080 → container:80)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="docker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="aws cloudformation deploy + s3 cp&lt;br&gt;HTTPS · TCP 443 (IAM-credentials)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy" target="aws"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="git push&lt;br&gt;HTTPS · TCP 443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dev" target="gh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="webhook / clone&lt;br&gt;HTTPS · TCP 443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=14;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gh" target="amp"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>

<mxCell id="vmbox" value="VM · WSL2 (Linux) · Docker-netværk 172.17.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fillColor=#e8f0fe;strokeColor=#1565c0;strokeWidth=3;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="940" y="810" width="330" height="180" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Dækker eksamenskriterier&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Netværk:&lt;/b&gt; IP, DNS (53), HTTPS (443), HTTP (80 → 301), lokalt 8080, NAT&lt;br&gt;&lt;br&gt;&lt;b&gt;Virtualisering/containere:&lt;/b&gt; WSL2-VM + Docker-container&lt;br&gt;&lt;br&gt;&lt;b&gt;Cloudmodel:&lt;/b&gt; PaaS (S3, CloudFront, Amplify), IaC&lt;br&gt;&lt;br&gt;&lt;b&gt;Sikkerhed:&lt;/b&gt; firewall, privat bucket, OAC, TLS&lt;br&gt;&lt;br&gt;&lt;b&gt;Drift:&lt;/b&gt; versionering, teardown-script&lt;br&gt;&lt;br&gt;&lt;b&gt;Økonomi:&lt;/b&gt; free tier&lt;br&gt;&lt;br&gt;&lt;i&gt;Ikke bygget: database, API, WAF, backup, VPN/SSO&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ikon-nøgle (farvet tekst under ikon)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#455a64'&gt;&lt;b&gt;FYSISK&lt;/b&gt;&lt;/font&gt; = fysisk maskine (PC, server, laptop)&lt;br&gt;&lt;font color='#1565c0'&gt;&lt;b&gt;VM&lt;/b&gt;&lt;/font&gt; = virtuel maskine&lt;br&gt;&lt;font color='#e65100'&gt;&lt;b&gt;CONTAINER&lt;/b&gt;&lt;/font&gt; = Docker/Fargate-container&lt;br&gt;&lt;font color='#2e7d32'&gt;&lt;b&gt;STORAGE&lt;/b&gt;&lt;/font&gt; = lager/filer/backup&lt;br&gt;&lt;font color='#ad1457'&gt;&lt;b&gt;DATABASE&lt;/b&gt;&lt;/font&gt; = database&lt;br&gt;&lt;font color='#6a1b9a'&gt;&lt;b&gt;GATEWAY&lt;/b&gt;&lt;/font&gt; = gateway/router/VPN/NAT&lt;br&gt;&lt;font color='#c62828'&gt;&lt;b&gt;FIREWALL&lt;/b&gt;&lt;/font&gt; = firewall/Security Group/WAF&lt;br&gt;&lt;font color='#00695c'&gt;&lt;b&gt;MANAGED&lt;/b&gt;&lt;/font&gt; = AWS-administreret tjeneste&lt;br&gt;&lt;br&gt;&lt;b&gt;Zoner:&lt;/b&gt; rød-stiplet = EKSTERNT netværk (internet), grøn/blå = INTERNT netværk (privat)&lt;br&gt;&lt;i&gt;Eksempel-IP: 203.0.113.x og 198.51.100.x er dokumentations-IP (RFC 5737). 10.x, 172.16-31.x og 192.168.x er private (RFC 1918).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="280" height="960" as="geometry"/></mxCell>

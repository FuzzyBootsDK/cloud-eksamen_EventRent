<mxCell id="legend" value="&lt;b&gt;Dækker eksamenskriterier&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Netværk:&lt;/b&gt; DNS (53), HTTPS (443), HTTP (80 → 301), lokalt 8080&lt;br&gt;&lt;br&gt;&lt;b&gt;Virtualisering/containere:&lt;/b&gt; WSL2-VM + Docker-container&lt;br&gt;&lt;br&gt;&lt;b&gt;Cloudmodel:&lt;/b&gt; PaaS (S3, CloudFront, Amplify), IaC via CloudFormation&lt;br&gt;&lt;br&gt;&lt;b&gt;Sikkerhed:&lt;/b&gt; privat bucket, OAC, TLS, kryptering i hvile&lt;br&gt;&lt;br&gt;&lt;b&gt;Drift:&lt;/b&gt; versionering (simpel genetablering), teardown-script&lt;br&gt;&lt;br&gt;&lt;b&gt;Økonomi:&lt;/b&gt; free tier, pay-as-you-go&lt;br&gt;&lt;br&gt;&lt;i&gt;Ikke bygget: database, API, WAF, backup, VPN/SSO&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="270" height="860" as="geometry"/></mxCell>

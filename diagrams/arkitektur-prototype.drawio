<mxCell id="title" value="EventRent A/S – IMPLEMENTERET PROTOTYPE (dummy-side)" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#1a237e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="50" as="geometry"/></mxCell>
<mxCell id="sub" value="Alt på tegningen er bygget og kan demonstreres. Pile viser protokol og port. IP-adresser er eksempler." style="text;html=1;fontSize=16;fontColor=#455a64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1400" height="30" as="geometry"/></mxCell>
